{
	"name": "neko",
	"version": "0.1.0",
	"description": "Neko - Minimalist Components V2 Anime Discord Bot built on Bun, TypeScript 7, and Sapphire Framework",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun --watch run src/index.ts",
		"typecheck": "bunx tsgo --noEmit",
		"check": "bunx biome check --write .",
		"lint": "bunx biome lint .",
		"format": "bunx biome format --write .",
		"test": "bun test"
	},
	"dependencies": {
		"@sapphire/framework": "latest",
		"@sapphire/plugin-logger": "latest",
		"@sapphire/plugin-scheduled-tasks": "latest",
		"@sapphire/plugin-utilities-store": "latest",
		"bullmq": "^5.0.0",
		"chalk": "^5.4.1",
		"common-tags": "^1.8.2",
		"dayjs": "^1.11.13",
		"discord.js": "latest",
		"dotenv": "^16.4.7",
		"drizzle-orm": "^0.40.0",
		"ioredis": "^5.6.0",
		"ky": "^1.7.5",
		"ms": "^2.1.3",
		"pino": "^9.6.0",
		"pino-pretty": "^13.0.0",
		"postgres": "^3.4.5",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "latest",
		"@types/common-tags": "^1.8.4",
		"@types/ms": "^2.1.0",
		"@typescript/native-preview": "latest",
		"drizzle-kit": "^0.30.5",
		"typescript": "^5.8.2"
	}
}
